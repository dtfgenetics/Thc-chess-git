# Kush Kings Chess / THC Chess production environment
# Target: dtfseeds.com games hub

APP_NAME="Kush Kings Chess"
NODE_ENV="production"

# Frontend public URL.
NEXT_PUBLIC_APP_NAME="Kush Kings Chess"
NEXT_PUBLIC_SITE_URL="https://chess.dtfseeds.com"
NEXT_PUBLIC_API_URL="https://chess-api.dtfseeds.com"

# Backend/server room settings.
# Hostinger managed Web Apps should use PORT=3000. The Docker/VPS compose path
# supplies its own internal API port and can continue using 3001.
PORT="3000"
CORS_ORIGIN="https://chess.dtfseeds.com,https://dtfseeds.com,https://www.dtfseeds.com"
SESSION_COOKIE_NAME="kush_kings_chess"
SESSION_COOKIE_DOMAIN=".dtfseeds.com"
SESSION_SECRET="<real secret in production>"

# PostgreSQL database. Use ONE of the following contracts.
#
# Managed Hostinger Web App + Supabase (preferred managed-hosting path):
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require"
#
# Or traditional PostgreSQL environment variables (VPS / Docker path):
PGHOST="<production postgres host>"
PGPORT="5432"
PGUSER="<production postgres user>"
PGPASSWORD="<production postgres password>"
PGDATABASE="kush_kings_chess"
